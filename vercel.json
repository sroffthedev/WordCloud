{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/join/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|js/|style\\.css|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
